# Database
DATABASE_URL=postgres://vecinohub:vecinohub@localhost:5432/vecinohub

# Auth
# BETTER_AUTH_SECRET must be a ≥32-char random string. Generate with:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
# Set to "true" to disable Better Auth's rate limiter. Leave unset/false in
# production; intended only for e2e runs that perform many sign-in/out cycles.
AUTH_RATE_LIMIT_DISABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VecinoHub <no-reply@vecinohub.local>

# Seed data
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
